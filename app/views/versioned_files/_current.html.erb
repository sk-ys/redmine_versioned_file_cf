<% if attachment %>
  <div class="revision-file-current" style="display:flex; align-items: center; gap: 0.5em;">
    <%= link_to_attachment attachment %>
    <% if revision %>
      <%= link_to\
        "(r#{revision.revision_number})",\
        history_versioned_files_path(custom_value_id: revision.custom_value_id),\
        class: 'revision-file-meta' %>
    <% end %>
  </div>
<% else %>
  <% if latest_revision.present? %>
    <%= link_to "(#{l(:label_history)})",\
      history_versioned_files_path(custom_value_id: latest_revision.custom_value_id),\
      class: 'revision-file-history-link' %>
  <% end %>
<% end %>