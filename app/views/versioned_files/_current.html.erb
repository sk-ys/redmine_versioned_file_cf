<% if attachment %>
  <div class="revision-file-current" style="display:flex; align-items: center; gap: 0.5em;">
    <%= link_to_attachment attachment %>
    <% if revision %>
      <span class="revision-file-meta">(r<%= revision.revision_number %>)</span>
      <%= link_to sprite_icon('history', l(:label_history)), history_versioned_files_path(custom_value_id: revision.custom_value_id), class: 'icon icon-history' %>
    <% end %>
  </div>
<% elsif value.present? %>
  <div class="wiki"><%= simple_format h(value) %></div>
<% end %>