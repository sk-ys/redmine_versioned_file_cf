<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'versioned_file_cf', plugin: 'redmine_versioned_file_cf' %>
  <script>
    function updateDescription(button) {
      const input = button.previousElementSibling;
      const revisionId = button.closest('tr').dataset.revisionId;
      const description = input.value;
      fetch('<%= update_description_versioned_files_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= form_authenticity_token %>'
        },
        body: JSON.stringify({ id: revisionId, description: description })
      }).then(response => {
        if (response.ok) {
          alert('<%= j l(:notice_successful_update) %>');
        } else {
          alert('<%= j l(:notice_failed_update, scope: :versioned_files) %>');
        }
      }).catch(() => {
        alert('<%= j l(:notice_failed_update, scope: :versioned_files) %>');
      });
    }
  </script>
<% end %>

<% object_title = title_from_customized(@custom_value.customized) %>

<h2>
  <%= safe_join([
    link_to_record(@custom_value.customized) || object_title,
    @custom_field.name + ' - ' + l(:label_history)
  ], ' » ') %>
</h2>

<% html_title "#{object_title} » #{@custom_field.name} - #{l(:label_history)}" %>

<%= form_tag(compare_versioned_files_path, method: :get) do %>
  <% show_diff = @revisions.size > 1 %>
  <%= hidden_field_tag :custom_value_id, @custom_value.id %>
  <% if show_diff %>
    <p><%= submit_tag l(:label_view_diff) %></p>
  <% end %>
  <table class="list wiki-page-versions">
    <thead>
      <tr>
        <th>#</th>
        <th></th>
        <th></th>
        <th><%= l(:field_updated_on) %></th>
        <th><%= l(:field_author) %></th>
        <th><%= l(:field_filename) %></th>
        <th><%= l(:field_is_text, scope: :versioned_file_cf) %></th>
        <th><%= l(:field_description) %></th>
      </tr>
    </thead>
    <tbody>
      <% line_num = 1 %>
      <% @revisions.each do |revision| %>
        <tr class="wiki-page-version" data-revision-id="<%= revision.id %>" data-attachment-id="<%= revision.attachment.id %>">
          <td class="id">r<%= revision.revision_number %></td>
          <td class="checkbox"><%= radio_button_tag('revision_id', revision.id, (line_num == 1), id: "cb-#{line_num}", onclick: "$('#cbto-#{line_num + 1}').prop('checked', true);") if show_diff && (line_num < @revisions.size) %></td>
          <td class="checkbox"><%= radio_button_tag('compare_to_id', revision.id, (line_num == 2), id: "cbto-#{line_num}") if show_diff && (line_num > 1) %></td>
          <td class="updated_on"><%= format_time(revision.created_at) %></td>
          <td class="author"><%= link_to_user revision.author %></td>
          <td class="filename">
            <span class="filename-with-actions">
              <%= link_to_attachment revision.attachment, class: "filename" %>
              <span class="actions">
                <%= link_to\
                  sprite_icon('download', l(:button_download)),\
                  download_named_attachment_path(revision.attachment, revision.attachment.filename),\
                  title: l(:button_download),\
                  class: 'icon icon-download icon-only' %>
                <% if User.current.allowed_to?(:restore_file_revision, @project) && !revision.active? %>
                  <%= link_to\
                    sprite_icon('cancel', l('versioned_file_cf.ui.restore')),\
                    restore_versioned_file_path(revision.id),\
                    method: :post,\
                    data: { confirm: l(:text_are_you_sure) },\
                    title: l('versioned_file_cf.ui.restore'),\
                    class: 'icon icon-cancel icon-only' %>
                <% else %>
                  <span class="blank-action"></span>
                <% end %>
                <% if User.current.allowed_to?(:remove_file_revision, @project) && !revision.active? %>
                  <%= link_to\
                    sprite_icon('del', l(:button_delete)),\
                    versioned_file_path(revision.id),\
                    method: :delete,\
                    data: { confirm: l(:text_are_you_sure) },\
                    title: l(:button_delete),\
                    class: 'icon icon-del icon-only' %>
                <% else %>
                  <span class="blank-action"></span>
                <% end %>
              </span>
            </span>
          </td>
          <td class="is_text">
            <%= checked_image  revision.attachment.readable? && revision.attachment.is_text? %>
          </td>
          <td class="description">
            <div>
              <% if @can_update_attachment_description %>
                <input type="text" value="<%= h(revision.attachment.description) %>">
                <button class="update-description" type="button" onclick="updateDescription(this)"><%= l(:button_update) %></button>
              <% else %>
                <%= h(revision.attachment.description) %>
              <% end %>
            </div>
          </td>
        </tr>
        <% line_num += 1 %>
      <% end %>
    </tbody>
  </table>
  <% if show_diff %>
    <p><%= submit_tag l(:label_view_diff) %></p>
  <% end %>
  <span class="pagination"><%= pagination_links_full @version_pages, @version_count %></span>
<% end %>